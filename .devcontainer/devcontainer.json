{
	"name": "uv",
	"image": "ghcr.io/astral-sh/uv:debian",
	"features": {
		"ghcr.io/devcontainers/features/common-utils:2.5.9": {}
	},
	"hostRequirements": {
		"gpu": "optional"
	},
	"mounts": [
		{
			"source": "uv",
			"target": "/home/vscode/.cache/uv",
			"type": "volume"
		},
		{
			"target": "${containerWorkspaceFolder}/.venv",
			"type": "volume"
		},
		{
			"source": "data-${devcontainerId}",
			"target": "${containerWorkspaceFolder}/data",
			"type": "volume"
		}
	],
	"containerEnv": {
		"UV_LINK_MODE": "copy"
	},
	"onCreateCommand": "sudo chown -R vscode:vscode /home/vscode/.cache/uv .venv data",
	"postCreateCommand": "uv sync && git submodule update --init --depth 1 data/google/fonts",
	"customizations": {
		"vscode": {
			"extensions": [
				"astral-sh.ty",
				"charliermarsh.ruff",
				"tamasfe.even-better-toml"
			]
		}
	},
	"remoteUser": "vscode"
}
